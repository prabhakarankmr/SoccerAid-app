# Android emulator can't resolve "localhost" as the host machine — use 10.0.2.2 there;
# iOS simulator and web can use localhost as-is.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=http://localhost:3000
EXPO_PUBLIC_ENV=development

# Firebase Console → Project settings → General → "Your apps" → Add app → Web (</>).
# Register it (any nickname), then copy the firebaseConfig values it gives you below.
# Only used by the web build (src/api/firebasePhoneAuth.web.ts) — native reads
# google-services.json / GoogleService-Info.plist instead and ignores these.
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=
EXPO_PUBLIC_FIREBASE_WEB_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_WEB_PROJECT_ID=socceraid-cf0af
EXPO_PUBLIC_FIREBASE_WEB_APP_ID=
